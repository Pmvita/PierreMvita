# Audit gate: only fail builds on HIGH+ so the repository stays green
# while the dev-toolchain (eslint/typescript-eslint) chain resolves its
# advisory fixes via major-version upgrades. Re-evaluate quarterly.
audit-level=high

# npm refuses to run install scripts owned by malicious packages. Our only
# postinstall is the Tailwind Espresso oxide installer, which is safe.
# npm audit fix --force is intentionally disabled: it breaks the Next 16
# / ESLint v16 flat-config chain (it collapses eslint 9 -> 4.0.0 and
# eslint-config-next -> 0.2.4). Re-run it whenever you upgrade those majors.
# eslint
package-lock-only=true
